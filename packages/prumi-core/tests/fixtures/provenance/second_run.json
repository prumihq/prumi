{
  "spec_version": 0,
  "dashboard": {"id": "regional-revenue-weekly", "title": "Regional Revenue Weekly"},
  "filters": [
    {"id": "period", "type": "time", "default": {"last": 12, "grain": "week"}},
    {"id": "region", "type": "dimension", "dimension": "customer__region", "default": []}
  ],
  "data": [
    {"id": "kpi", "title": "Headline figures", "metrics": ["revenue", "average_order_value"], "filters": ["period", "region"], "compare": "previous_period"},
    {"id": "trend", "title": "Weekly trend", "metrics": ["revenue", "average_order_value"], "time_grain": "week", "filters": ["period", "region"]},
    {
      "id": "regions",
      "title": "By region",
      "metrics": ["revenue", "average_order_value"],
      "dimensions": ["customer__region"],
      "filters": ["period"],
      "sort": {"by": "revenue", "descending": true},
      "compare": "previous_period",
      "total": true
    },
    {"id": "weekly_regions", "title": "Week by week, per region", "metrics": ["revenue", "average_order_value"], "dimensions": ["customer__region"], "time_grain": "week", "filters": ["period"]},
    {"id": "weekly_all", "title": "Week by week, all regions", "metrics": ["revenue", "average_order_value"], "time_grain": "week", "filters": ["period"]}
  ],
  "interactions": [{"from": "regions", "on": "click", "sets_filter": "region"}],
  "metric_requests": [],
  "presentation": {"bindings": {"#kpis": "kpi", "#trend": "trend", "#regions": "regions", "#detail": "weekly_regions", "#detail-all": "weekly_all"}}
}
