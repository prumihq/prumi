# Copy this file to .env, next to docker-compose.yml, and fill in your values.
# .env holds passwords: keep it out of version control.

# The dbt project's folder on this machine. Prumi reads its target/semantic_manifest.json,
# which `dbt parse` writes. A relative path is relative to this folder.
DBT_PROJECT_DIR=

# The port Prumi answers on, on this machine only (127.0.0.1). Connect your agent to
# http://127.0.0.1:<port>/mcp.
PRUMI_PORT=8484

# The warehouse dbt builds into (Postgres). A server on this machine is host.docker.internal,
# not localhost: inside the container, localhost is the container itself.
PRUMI__SOURCE__DBT__CONNECTION__HOST=
# The database dbt built.
PRUMI__SOURCE__DBT__CONNECTION__DBNAME=
# The role Prumi connects as: give it read-only access.
PRUMI__SOURCE__DBT__CONNECTION__USER=
# The name of the variable below that holds the role's password.
PRUMI__SOURCE__DBT__CONNECTION__PASSWORD_ENV=WAREHOUSE_PASSWORD
# The warehouse role's password.
WAREHOUSE_PASSWORD=

# The password of Prumi's registry database, in its own container. Choose one; it's set when
# the registry is first created.
REGISTRY_PASSWORD=

# Optional settings: uncomment the ones you need.
# The warehouse's port (default 5432).
# PRUMI__SOURCE__DBT__CONNECTION__PORT=5432
# disable, allow, prefer, require, verify-ca or verify-full (unset, libpq decides).
# PRUMI__SOURCE__DBT__CONNECTION__SSLMODE=require
# The session's time zone (unset, the connection keeps its own).
# PRUMI__SOURCE__DBT__CONNECTION__TIMEZONE=America/Sao_Paulo
# How every viewer sees numbers and dates (default en-US).
# PRUMI__SERVER__LOCALE=en-US
# The hosts dashboards may load scripts, stylesheets and fonts from, comma-separated.
# PRUMI__SERVER__SCRIPT_HOSTS=cdn.jsdelivr.net,cdnjs.cloudflare.com,unpkg.com
# PRUMI__SERVER__STYLE_HOSTS=cdn.jsdelivr.net,cdnjs.cloudflare.com,unpkg.com,fonts.googleapis.com
# PRUMI__SERVER__FONT_HOSTS=cdn.jsdelivr.net,cdnjs.cloudflare.com,unpkg.com,fonts.gstatic.com
# A name for people: the home page shows it in its header.
# PRUMI__SOURCE__PROJECT=analytics
